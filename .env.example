# Required
OPENAI_API_KEY=

# Optional: Postgres with pgvector (e.g. Neon). Required when deployed to
# serverless hosts such as Vercel; leave unset to keep documents in memory.
DATABASE_URL=

# Optional: required only for the scheduled daily PIB pull (vercel.json's
# cron hitting GET /api/media/ingest-pib). Vercel sends this as
# "Authorization: Bearer <value>" on every cron invocation; the route
# rejects the request if it's missing or doesn't match. Not needed for
# local dev or the manual "Pull latest releases" button (that uses POST).
CRON_SECRET=

# Optional: change the models used by the demo.
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# V1 retrieval settings
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MIN_SIMILARITY=0.15
RAG_MAX_CONTEXT_CHARS=12000
MAX_PDF_MB=20
MAX_PDF_PAGES=250
MAX_CHUNKS_PER_DOCUMENT=5000
